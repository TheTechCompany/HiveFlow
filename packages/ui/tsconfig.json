{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist/",
    "rootDir": "src/",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test*", "src/**/__tests__/**", "src/**/__stories__/**"]
}
