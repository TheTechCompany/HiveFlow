model CalendarItem {
  id String @id

  start DateTime
  end   DateTime

  groupBy Json?

  data Json?

  comments CalendarItemComment[] @relation(name: "hasComment")

  permissions CalendarItemPermissions[] @relation(name: "hasPermissions")

  createdBy String?

  organisation String
}

model CalendarItemPermissions {
  id String @id

  user String

  permissions String[]

  item   CalendarItem @relation(name: "hasPermissions", references: [id], fields: [itemId], onDelete: Cascade)
  itemId String

  createdAt DateTime @default(now())
}

model CalendarItemComment {
  id        String   @id
  message   String
  user      String
  createdAt DateTime @default(now())

  item   CalendarItem @relation(name: "hasComment", references: [id], fields: [itemId], onDelete: Cascade)
  itemId String
}

// model CalendarAnnotation {
//     id String @id
// }

model LeaveAssignment {
  id String @id

  user String

  start DateTime
  end   DateTime

  createdAt DateTime @default(now())
  createdBy String

  organisation String?
}

model SkillAssignment {
  id String @id

  user  String
  skill String

  skillData Json?

  organisation String?

  @@unique([user, skill])
}

model PlanBatch {
  id        String  @id
  displayId String?

  title       String
  description String?

  status String @default("draft") // draft, in_review, approved, released

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  items    PlanBatchItem[]
  comments BatchComment[]

  reviewer String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  organisation String

  @@unique([organisation, displayId])
}

model BatchComment {
  id        String   @id
  message   String
  user      String
  createdAt DateTime @default(now())

  batch   PlanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String

  parent   BatchComment? @relation("BatchCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  parentId String?
  replies  BatchComment[] @relation("BatchCommentReplies")
}

model PlanBatchItem {
  id String @id

  batch   PlanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  parent   PlanBatchItem? @relation("PlanBatchItemChildren", fields: [parentItemId], references: [id], onDelete: SetNull)
  parentItemId String?
  children  PlanBatchItem[] @relation("PlanBatchItemChildren")

  scheduledStart DateTime?
  scheduledEnd   DateTime?
  estimatedHours Float?

  rank String?

  notes String?

  organisation String
}

// ── Recurring Schedules ─────────────────────────────────────

model RecurringSchedule {
  id        String  @id
  displayId String?

  name        String
  description String?

  events RecurringEvent[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation String

  @@unique([organisation, displayId])
}

model RecurringEvent {
  id String @id

  schedule   RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String

  parent   RecurringEvent? @relation("RecurringEventChildren", fields: [parentId], references: [id], onDelete: SetNull)
  parentId String?
  children RecurringEvent[] @relation("RecurringEventChildren")

  name        String
  description String?
  frequency   String @default("monthly") // daily, weekly, monthly, quarterly, yearly
  startDate   String
  endDate     String?
  assignedTo  String?
  rowOrder    String?
  exceptionDates Json?

  generatedTasks ProjectTask[] @relation(name: "generatedFrom")

  organisation String
}

// ── Compliance ──────────────────────────────────────────────

model Regulation {
  id String @id

  title       String
  description String?
  type        String   // act | regulation | code | standard
  source      String
  category    String?
  isoClause   String?

  status     String @default("draft") // active | under-review | superseded | draft
  linkStatus String @default("unchecked") // verified | stale | broken | unchecked

  storedHash      String?
  storedPdf       String?
  storedMarkdown  String?

  lastVerifiedAt DateTime?

  currentVersion Int @default(1)

  versions  RegulationVersion[]
  breakouts BreakoutPoint[]
  proofs    ProofEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation String
}

model RegulationVersion {
  id String @id

  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String

  version  Int
  changes  String?
  file     String?

  createdAt DateTime @default(now())
}

model BreakoutPoint {
  id String @id

  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String

  sectionRef String
  title      String
  summary    String?
  pageRef    Int?
  markdownSnippet String?

  understanding String @default("pending") // acknowledged | pending | needs-review
  reviewedBy    String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
}

model ProofEntry {
  id String @id

  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String

  userName  String
  action    String // viewed | acknowledged | reviewed
  timestamp DateTime @default(now())
}

// ── Continuous Improvement ──────────────────────────────────

model ContinuousImprovement {
  id        String  @id
  displayId String?

  title       String
  description String?

  category String? // Safety | Quality | Process | Equipment | 5S | Training | Environmental | Other
  source   String? // staff-suggestion | internal-audit | customer-feedback | management-review | incident-report | other

  status   String  @default("identified") // identified | in_progress | implemented | verified | closed
  priority String? // low | medium | high | critical

  impact          String?
  rootCause       String?
  actionTaken     String?
  outcomeMeasured String?

  createdBy  String?
  assignedTo String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  organisation String

  @@unique([organisation, displayId])
}
